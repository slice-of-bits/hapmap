{
	"name": "hapmap",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"generate": "openapi-ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "6.0.6",
		"@sveltejs/kit": "3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "26.6.11",
		"@vitest/browser-playwright": "5.1.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "5.1.2",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@dopry/svelte-oidc": "^1.2.0",
		"@macfja/svelte-persistent-runes": "^1.1.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@tanstack/svelte-query": "^6.4.7",
		"carta-md": "^4.11.5",
		"fuse.js": "^7.5.0",
		"svelte-markdown": "^0.4.1",
		"svelte-select": "^6.0.0"
	},
	"engines": {
		"node": "26.13.1"
	},
	"packageManager": "pnpm@12.23.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	}
}
